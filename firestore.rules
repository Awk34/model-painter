rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Public Read-Only Catalog Collections (managed offline / via Admin SDK):
//   - /catalog_meta/{docId}
//   - /colours/{docId}
//   - /recipes/{docId}
//   Access: Public read-only (`allow read: if true; allow write: if false;`).
//
// Collection: users
// Document ID: {userId} (must match `request.auth.uid`)
// Schema (`UserAccountState` non-project account state synced via `setDoc(..., { merge: true })`;
//   user projects live exclusively in `/users/{userId}/projects/{projectId}`):
//   - schemaVersion: number (optional on partial merge, 1..1000) - state schema version
//   - updatedAt: string (optional on partial merge, 1..64 chars) - ISO 8601 timestamp
//   - inventoryPaintIds: list<string> (optional, size <= 1000) - owned paint IDs
//   - wishlistPaintIds: list<string> (optional, size <= 500) - wishlisted paint IDs
//   - inventoryModelIds: list<string> (optional, size <= 2000) - owned model IDs
//   - wishlistModelIds: list<string> (optional, size <= 1000) - wishlisted model IDs
//   - customPaints: list<map> (optional, size <= 200) - user-created 3rd-party paints
//   - customCompatibilityOverrides: map<string, list<string>> (optional, size <= 500, each list <= 20) - paint equivalence map
//   - modelProgress: map<string, list<string>> (optional, size <= 500, each list <= 200) - completed painting step/area IDs per model
//   - uploadedPhotos: list<map> (optional, size <= 250) - standalone catalog-model (`targetType == 'model'`) photo metadata
//   - preferences: map (optional, exact 4 UserPreferences keys) - user UI & substitution preferences
//
// Subcollection: users/{userId}/projects
// Document ID: {projectId} (must match `id` field, 1..120 chars)
// Schema (`UserProject` self-contained document):
//   - id: string (required, immutable, == projectId, 1..120 chars)
//   - name: string (required, 1..200 chars)
//   - thumbnailUrl: string | null (optional, <= 2048 chars)
//   - localThumbnailPath: string | null (optional, <= 512 chars)
//   - coverPhotoId: string | null (optional, <= 120 chars)
//   - createdAt: string (required, immutable on update, 1..64 chars)
//   - updatedAt: string (required, 1..64 chars)
//   - colorIds: list<string> (required, size <= 100, each <= 200 chars)
//   - notes: list<map> (required, size <= 50) - `UserProjectNote` entries with `components` (size <= 100)
//   - photos: list<map> (required, size <= 18) - `UserUploadedPhoto` entries scoped to `targetType == 'project'` & `targetId == projectId`
//   - models: list<map> (required, size <= 100) - `ProjectModelEntry` items with `quantity` (int 1..999),
//       `notes` (string <= 5000), `completedStepIds` (list <= 200), optional `featuredImage`,
//       `photos` (list <= 13 scoped to `targetType == 'project_model'` & `targetId == entry.id`),
//       and optional `configurations` (list <= 30)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the authenticated user owns the user-scoped document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Validate list type & maximum size bounds (CEL has no loops)
    function isValidStringIdList(items, maxSize) {
      return items is list && items.size() <= maxSize;
    }

    // Spot-check first and last values of a non-empty `map<string, list<string>>` (CEL has no loops)
    function hasValidStringListMapValues(vals, maxListSize) {
      let n = vals.size();
      let v0 = vals[0];
      let vn = vals[n - 1];
      return v0 is list && v0.size() <= maxListSize
        && (n == 1 || (vn is list && vn.size() <= maxListSize));
    }

    function isValidStringListMap(m, maxKeys, maxListSize) {
      return m is map
        && m.size() <= maxKeys
        && (m.size() == 0 || hasValidStringListMapValues(m.values(), maxListSize));
    }

    // Validate that a Cloud Storage object path is scoped to `users/{userId}/{folder}/{targetType}/{targetId}/{fileName}`
    function isValidScopedStoragePath(storagePath, userId, kind, targetType) {
      return storagePath is string
        && storagePath.matches(
          '^users/' + userId + (kind == 'reference' ? '/private_references/' : '/showcase/') + targetType + '/[^/.][^/]{0,119}/[^/.][^/]{0,119}$'
        );
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    // Full UserUploadedPhoto field validation (used for account-level head elements)
    function isValidUploadedPhotoCore(photo, userId, expectedTargetType) {
      return photo is map
        && photo.keys().hasOnly([
          'id',
          'targetType',
          'targetId',
          'kind',
          'isPrivate',
          'fileName',
          'mimeType',
          'sizeBytes',
          'width',
          'height',
          'caption',
          'createdAt',
          'storagePath'
        ])
        && photo.targetType == expectedTargetType
        && photo.isPrivate is bool
        && (photo.kind == 'reference' ? photo.isPrivate : photo.kind == 'showcase')
        && photo.mimeType in ['image/jpeg', 'image/png', 'image/webp']
        && photo.sizeBytes is int && photo.sizeBytes > 0 && photo.sizeBytes <= 5242880
        && (photo.get('caption', null) == null || (photo.caption is string && photo.caption.size() <= 140))
        && (
          photo.get('storagePath', null) == null
          || isValidScopedStoragePath(photo.storagePath, userId, photo.kind, expectedTargetType)
        );
    }

    // Project-scoped security-core UserUploadedPhoto validation (fits CEL budget with 4 project/model photos)
    function isValidProjectPhotoCore(photo, userId, expectedTargetType) {
      return photo is map
        && photo.keys().hasOnly([
          'id',
          'targetType',
          'targetId',
          'kind',
          'isPrivate',
          'fileName',
          'mimeType',
          'sizeBytes',
          'width',
          'height',
          'caption',
          'createdAt',
          'storagePath'
        ])
        && photo.targetType == expectedTargetType
        && (photo.kind == 'reference' ? photo.isPrivate == true : photo.kind == 'showcase')
        && photo.sizeBytes is int && photo.sizeBytes <= 5242880
        && (
          photo.get('storagePath', null) == null
          || isValidScopedStoragePath(photo.storagePath, userId, photo.kind, expectedTargetType)
        );
    }

    // Compact security-core UserUploadedPhoto validation (used for tail/secondary elements within CEL budget)
    function isValidUploadedPhotoLite(photo, userId, expectedTargetType) {
      return photo is map
        && photo.keys().hasOnly([
          'id',
          'targetType',
          'targetId',
          'kind',
          'isPrivate',
          'fileName',
          'mimeType',
          'sizeBytes',
          'width',
          'height',
          'caption',
          'createdAt',
          'storagePath'
        ])
        && photo.targetType == expectedTargetType
        && (photo.kind == 'reference' ? photo.isPrivate == true : photo.kind == 'showcase')
        && photo.sizeBytes <= 5242880
        && (
          photo.get('storagePath', null) == null
          || isValidScopedStoragePath(photo.storagePath, userId, photo.kind, expectedTargetType)
        );
    }

    function isValidUploadedPhotosList(photos, userId) {
      let n = photos.size();
      let p0 = photos[0];
      let pn = photos[n - 1];
      return photos is list
        && photos.size() <= 250
        && (
          n == 0
          || (
            isValidUploadedPhotoCore(p0, userId, 'model')
            && p0.targetId is string
            && (
              n == 1
              || isValidUploadedPhotoLite(pn, userId, 'model')
            )
          )
        );
    }

    // Validate a ThirdPartyCitadelMatch item inside a custom ThirdPartyPaint
    function isValidThirdPartyCitadelMatch(m) {
      return m is map
        && m.keys().hasOnly([
          'citadelPaintId',
          'citadelPaintName',
          'citadelRange',
          'citadelCategory',
          'citadelHex',
          'deltaE',
          'matchQuality'
        ])
        && m.citadelPaintId is string && m.citadelPaintId != ''
        && m.deltaE is number
        && m.matchQuality in ['exact', 'close', 'similar'];
    }

    // Validate a custom ThirdPartyPaint entry (full check on head, compact core on tail)
    function isValidCustomPaint(paint) {
      let codeVal = paint.get('code', null);
      let potVal = paint.get('potStyle', null);
      let matches = paint.citadelMatches;
      return paint is map
        && paint.keys().hasOnly([
          'id',
          'brand',
          'range',
          'code',
          'name',
          'category',
          'potStyle',
          'hex',
          'citadelMatches',
          'isCustom'
        ])
        && paint.id is string && paint.id != '' && paint.id.size() <= 120
        && paint.name is string && paint.name != '' && paint.name.size() <= 120
        && (codeVal == null || codeVal is string)
        && (potVal == null || potVal is string)
        && matches is list && matches.size() <= 20
        && (
          matches.size() == 0
          || isValidThirdPartyCitadelMatch(matches[0])
        );
    }

    function isValidCustomPaintLite(paint) {
      return paint is map
        && paint.keys().hasOnly([
          'id',
          'brand',
          'range',
          'code',
          'name',
          'category',
          'potStyle',
          'hex',
          'citadelMatches',
          'isCustom'
        ])
        && paint.citadelMatches is list && paint.citadelMatches.size() <= 20;
    }

    function isValidCustomPaintsList(paints) {
      let n = paints.size();
      return paints is list
        && paints.size() <= 200
        && (
          n == 0
          || (
            isValidCustomPaint(paints[0])
            && (n == 1 || isValidCustomPaintLite(paints[n - 1]))
          )
        );
    }

    // Validate UserPreferences map
    function isValidPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasOnly([
          'defaultRangeFilter',
          'allowCompatibleSubstitutions',
          'allowThirdPartySubstitutions',
          'preferredThirdPartyBrands'
        ])
        && prefs.defaultRangeFilter in ['all', 'warhammer_colour', 'warhammer_pro']
        && prefs.allowCompatibleSubstitutions is bool
        && prefs.allowThirdPartySubstitutions is bool
        && isValidStringIdList(prefs.preferredThirdPartyBrands, 50);
    }

    // Validate full or partial (`merge: true`) UserAccountState document
    function isValidUserAccountState(data, userId) {
      return data is map
        && data.keys().hasOnly([
          'schemaVersion',
          'updatedAt',
          'inventoryPaintIds',
          'wishlistPaintIds',
          'inventoryModelIds',
          'wishlistModelIds',
          'customPaints',
          'customCompatibilityOverrides',
          'modelProgress',
          'uploadedPhotos',
          'preferences'
        ])
        && data.keys().size() >= 1
        && (!('schemaVersion' in data) || (data.schemaVersion is number && data.schemaVersion >= 1 && data.schemaVersion <= 1000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('inventoryPaintIds' in data) || isValidStringIdList(data.inventoryPaintIds, 1000))
        && (!('wishlistPaintIds' in data) || isValidStringIdList(data.wishlistPaintIds, 500))
        && (!('inventoryModelIds' in data) || isValidStringIdList(data.inventoryModelIds, 2000))
        && (!('wishlistModelIds' in data) || isValidStringIdList(data.wishlistModelIds, 1000))
        && (!('customPaints' in data) || isValidCustomPaintsList(data.customPaints))
        && (!('customCompatibilityOverrides' in data) || isValidStringListMap(data.customCompatibilityOverrides, 500, 20))
        && (!('modelProgress' in data) || isValidStringListMap(data.modelProgress, 500, 200))
        && (!('uploadedPhotos' in data) || isValidUploadedPhotosList(data.uploadedPhotos, userId))
        && (!('preferences' in data) || isValidPreferences(data.preferences));
    }

    // ===============================================================
    // Project Subcollection Validators (`/users/{userId}/projects/{projectId}`)
    // ===============================================================

    // Validate a single UserProjectNoteComponent entry
    function isValidNoteComponent(comp) {
      return comp is map
        && comp.keys().hasOnly(['id', 'type', 'value', 'checked'])
        && comp.type in ['text', 'checkbox']
        && comp.value is string && comp.value.size() <= 2000;
    }

    // Validate a UserProjectNote entry
    function isValidProjectNoteHead(note) {
      let comps = note.components;
      return note is map
        && note.keys().hasOnly(['id', 'title', 'createdAt', 'updatedAt', 'components'])
        && note.components is list && note.components.size() <= 100
        && (comps.size() == 0 || isValidNoteComponent(comps[0]));
    }

    function isValidProjectNotesList(notes) {
      return notes is list
        && notes.size() <= 50
        && (notes.size() == 0 || isValidProjectNoteHead(notes[0]));
    }

    // Validate project-level photos list (first & last, strictly scoped to this project)
    function isValidProjectPhotosList(photos, userId, projectId) {
      let n = photos.size();
      let p0 = photos[0];
      let pn = photos[n - 1];
      return photos is list
        && photos.size() <= 18
        && (
          n == 0
          || (
            isValidProjectPhotoCore(p0, userId, 'project') && p0.targetId == projectId
            && (
              n == 1
              || (isValidUploadedPhotoLite(pn, userId, 'project') && pn.targetId == projectId)
            )
          )
        );
    }

    // Validate ProjectModelFeaturedImage discriminated union
    function isValidFeaturedImage(fi) {
      return fi is map
        && fi.keys().hasOnly(['source', 'photoId', 'imageIndex', 'modelId', 'localImagePath', 'imageUrl'])
        && fi.source in ['uploaded_photo', 'catalog_angle', 'catalog_model'];
    }

    // Validate a single ProjectModelConfiguration entry
    function isValidModelConfiguration(cfg) {
      return cfg is map
        && cfg.keys().hasOnly(['id', 'slot', 'option', 'optionId', 'notes']);
    }

    // Validate head ProjectModelEntry item inside a project document
    function isValidProjectModelHead(entry, userId, checkLastPhotoAndCfg) {
      let fi = entry.get('featuredImage', null);
      let photos = entry.photos;
      let np = photos.size();
      let p0 = photos[0];
      let pn = photos[np - 1];
      let cfgs = entry.configurations;
      let nc = cfgs.size();
      let eid = entry.id;
      return entry is map
        && entry.keys().hasOnly([
          'id',
          'recipeId',
          'customName',
          'quantity',
          'notes',
          'completedStepIds',
          'featuredImage',
          'photos',
          'configurations',
          'createdAt',
          'updatedAt'
        ])
        && entry.quantity is int && entry.quantity >= 1 && entry.quantity <= 999
        && entry.notes is string && entry.notes.size() <= 5000
        && entry.completedStepIds is list && entry.completedStepIds.size() <= 200
        && (fi == null || isValidFeaturedImage(fi))
        && entry.photos is list && entry.photos.size() <= 13
        && (
          np == 0
          || (
            isValidProjectPhotoCore(p0, userId, 'project_model') && p0.targetId == eid
            && (!checkLastPhotoAndCfg || np == 1 || (isValidUploadedPhotoLite(pn, userId, 'project_model') && pn.targetId == eid))
          )
        )
        && (
          !('configurations' in entry)
          || (
            entry.configurations is list && entry.configurations.size() <= 30
            && (
              nc == 0
              || (
                isValidModelConfiguration(cfgs[0])
                && (!checkLastPhotoAndCfg || nc == 1 || isValidModelConfiguration(cfgs[nc - 1]))
              )
            )
          )
        );
    }

    // Compact validation for tail ProjectModelEntry within CEL expression budget
    function isValidProjectModelTail(entry, userId) {
      let photos = entry.photos;
      let np = photos.size();
      let pn = photos[np - 1];
      return entry is map
        && entry.keys().hasOnly([
          'id',
          'recipeId',
          'customName',
          'quantity',
          'notes',
          'completedStepIds',
          'featuredImage',
          'photos',
          'configurations',
          'createdAt',
          'updatedAt'
        ])
        && entry.photos is list && entry.photos.size() <= 13
        && (
          np == 0
          || (isValidUploadedPhotoLite(pn, userId, 'project_model') && pn.targetId == entry.id)
        );
    }

    function isValidProjectModelsList(models, userId) {
      let n = models.size();
      return models is list
        && models.size() <= 100
        && (
          n == 0
          || (n == 1 && isValidProjectModelHead(models[0], userId, true))
          || (
            n > 1
            && isValidProjectModelHead(models[0], userId, false)
            && isValidProjectModelTail(models[n - 1], userId)
          )
        );
    }

    // Validate a self-contained UserProject document in `/users/{userId}/projects/{projectId}`
    function isValidProjectDoc(proj, userId, projectId) {
      return proj is map
        && proj.keys().hasOnly([
          'id',
          'name',
          'thumbnailUrl',
          'localThumbnailPath',
          'coverPhotoId',
          'createdAt',
          'updatedAt',
          'models',
          'colorIds',
          'notes',
          'photos'
        ])
        && proj.id == projectId
        && proj.name is string && proj.name.size() <= 200
        && proj.createdAt is string
        && isValidStringIdList(proj.colorIds, 100)
        && isValidProjectNotesList(proj.notes)
        && isValidProjectPhotosList(proj.photos, userId, projectId)
        && isValidProjectModelsList(proj.models, userId);
    }

    // ===============================================================
    // Public Read-Only Catalog Collections & Manifest/Bundles
    // ===============================================================

    match /catalog_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /colours/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /recipes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Per-User Cloud Sync Document (`/users/{userId}`) & Projects Subcollection
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUserAccountState(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidUserAccountState(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // Self-contained user project documents (`/users/{userId}/projects/{projectId}`)
      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidProjectDoc(request.resource.data, userId, projectId);
        allow update: if isOwner(userId)
          && isValidProjectDoc(request.resource.data, userId, projectId)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isOwner(userId);
      }
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
