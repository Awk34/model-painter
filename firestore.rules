rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Public Read-Only Catalog Collections (managed offline / via Admin SDK):
//   - /catalog_meta/{docId}
//   - /paints/{docId}
//   - /paint_compatibility/{docId}
//   - /third_party_paints/{docId}
//   - /colours/{docId}
//   - /colour_groups/{docId}
//   - /games/{docId}
//   - /factions/{docId}
//   - /recipes/{docId}
//   Access: Public read-only (`allow read: if true; allow write: if false;`).
//
// Collection: users
// Document ID: {userId} (must match `request.auth.uid`)
// Schema (`UserAccountState` synced via `setDoc(..., { merge: true })`):
//   - schemaVersion: number (optional on partial merge, 1..1000) - state schema version
//   - updatedAt: string (optional on partial merge, 1..64 chars) - ISO 8601 timestamp
//   - inventoryPaintIds: list<string> (optional, size <= 1000) - owned paint IDs
//   - wishlistPaintIds: list<string> (optional, size <= 500) - wishlisted paint IDs
//   - inventoryModelIds: list<string> (optional, size <= 2000) - owned model IDs
//   - wishlistModelIds: list<string> (optional, size <= 1000) - wishlisted model IDs
//   - customPaints: list<map> (optional, size <= 200) - user-created 3rd-party paints
//   - customCompatibilityOverrides: map<string, list<string>> (optional, size <= 500) - paint equivalence map
//   - modelProgress: map<string, list<string>> (optional, size <= 500) - completed painting step/area IDs per model
//   - projects: list<map> (optional, size <= 50) - user hobby projects
//   - uploadedPhotos: list<map> (optional, size <= 250) - user-uploaded showcase & private reference photo metadata
//   - preferences: map (optional, size <= 10) - user UI & substitution preferences
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the user-scoped document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify optional uid field hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    // Ensure optional uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    // Validate that a map contains only the explicitly allowed keys
    function hasOnlyAllowedFields(data, fields) {
      return data is map && data.keys().hasOnly(fields);
    }

    // Validate that a value is a list within maximum size bounds
    function isValidList(val, maxSize) {
      return val is list && val.size() <= maxSize;
    }

    // Spot-check first and last elements of string ID lists (CEL has no loops)
    function isValidStringIdList(items, maxSize) {
      return isValidList(items, maxSize)
        && (
          items.size() == 0
          || (
            items[0] is string
            && items[0].size() > 0
            && items[0].size() <= 200
            && items[items.size() - 1] is string
            && items[items.size() - 1].size() > 0
            && items[items.size() - 1].size() <= 200
          )
        );
    }

    // Validate split segments of a user-scoped Cloud Storage object path
    function hasValidScopedStorageSegments(parts, userId) {
      return parts.size() == 6
        && parts[0] == 'users'
        && parts[1] == userId
        && parts[2] in ['showcase', 'private_references']
        && parts[3] in ['model', 'project']
        && parts[4].size() > 0
        && parts[4].size() <= 120
        && parts[4] != '.'
        && parts[4] != '..'
        && parts[5].size() > 0
        && parts[5].size() <= 120
        && parts[5] != '.'
        && parts[5] != '..';
    }

    // Validate that a Cloud Storage object path is strictly scoped to `users/{userId}/...`
    function isScopedStoragePath(path, userId) {
      return path is string
        && path.size() > 0
        && path.size() <= 512
        && hasValidScopedStorageSegments(path.split('/'), userId);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    // Validate a UserUploadedPhoto entry (spot-checked on list boundaries)
    function isValidUploadedPhoto(photo, userId) {
      return hasOnlyAllowedFields(photo, [
          'id',
          'targetType',
          'targetId',
          'kind',
          'isPrivate',
          'fileName',
          'mimeType',
          'sizeBytes',
          'width',
          'height',
          'caption',
          'createdAt',
          'storagePath'
        ])
        && (!('id' in photo) || (photo.id is string && photo.id.size() > 0 && photo.id.size() <= 120))
        && (!('targetType' in photo) || (photo.targetType in ['model', 'project']))
        && (!('targetId' in photo) || (photo.targetId is string && photo.targetId.size() > 0 && photo.targetId.size() <= 200))
        && (!('kind' in photo) || (photo.kind in ['showcase', 'reference']))
        && (!('isPrivate' in photo) || (photo.isPrivate is bool && (!('kind' in photo) || photo.kind != 'reference' || photo.isPrivate == true)))
        && (!('fileName' in photo) || (photo.fileName is string && photo.fileName.size() > 0 && photo.fileName.size() <= 255))
        && (!('mimeType' in photo) || (photo.mimeType in ['image/jpeg', 'image/png', 'image/webp']))
        && (!('sizeBytes' in photo) || (photo.sizeBytes is number && photo.sizeBytes > 0 && photo.sizeBytes <= 5 * 1024 * 1024))
        && (!('width' in photo) || photo.width == null || (photo.width is number && photo.width > 0 && photo.width <= 32768))
        && (!('height' in photo) || photo.height == null || (photo.height is number && photo.height > 0 && photo.height <= 32768))
        && (!('caption' in photo) || photo.caption == null || (photo.caption is string && photo.caption.size() <= 140))
        && (!('createdAt' in photo) || (photo.createdAt is string && photo.createdAt.size() > 0 && photo.createdAt.size() <= 64))
        && (!('storagePath' in photo) || photo.storagePath == null || isScopedStoragePath(photo.storagePath, userId));
    }

    function isValidUploadedPhotosList(photos, userId) {
      return isValidList(photos, 250)
        && (
          photos.size() == 0
          || (
            isValidUploadedPhoto(photos[0], userId)
            && isValidUploadedPhoto(photos[photos.size() - 1], userId)
          )
        );
    }

    // Validate a UserProject entry (spot-checked on list boundaries)
    function isValidProject(proj) {
      return proj is map
        && proj.size() <= 20
        && (!('id' in proj) || (proj.id is string && proj.id.size() > 0 && proj.id.size() <= 120))
        && (!('name' in proj) || (proj.name is string && proj.name.size() > 0 && proj.name.size() <= 200))
        && (!('recipeIds' in proj) || isValidList(proj.recipeIds, 100))
        && (!('colorIds' in proj) || isValidList(proj.colorIds, 100))
        && (!('notes' in proj) || isValidList(proj.notes, 50))
        && (!('coverPhotoId' in proj) || proj.coverPhotoId == null || (proj.coverPhotoId is string && proj.coverPhotoId.size() <= 120))
        && (!('thumbnailUrl' in proj) || proj.thumbnailUrl == null || (proj.thumbnailUrl is string && proj.thumbnailUrl.size() <= 2048))
        && (!('localThumbnailPath' in proj) || proj.localThumbnailPath == null || (proj.localThumbnailPath is string && proj.localThumbnailPath.size() <= 512))
        && (!('createdAt' in proj) || (proj.createdAt is string && proj.createdAt.size() <= 64))
        && (!('updatedAt' in proj) || (proj.updatedAt is string && proj.updatedAt.size() <= 64));
    }

    function isValidProjectsList(projects) {
      return isValidList(projects, 50)
        && (
          projects.size() == 0
          || (
            isValidProject(projects[0])
            && isValidProject(projects[projects.size() - 1])
          )
        );
    }

    // Validate a custom ThirdPartyPaint entry (spot-checked on list boundaries)
    function isValidCustomPaint(paint) {
      return paint is map
        && paint.size() <= 15
        && (!('id' in paint) || (paint.id is string && paint.id.size() > 0 && paint.id.size() <= 120))
        && (!('brand' in paint) || (paint.brand is string && paint.brand.size() <= 120))
        && (!('range' in paint) || (paint.range is string && paint.range.size() <= 120))
        && (!('code' in paint) || paint.code == null || (paint.code is string && paint.code.size() <= 64))
        && (!('name' in paint) || (paint.name is string && paint.name.size() > 0 && paint.name.size() <= 120))
        && (!('category' in paint) || (paint.category is string && paint.category.size() <= 64))
        && (!('hex' in paint) || (paint.hex is string && paint.hex.size() <= 16))
        && (!('citadelMatches' in paint) || isValidList(paint.citadelMatches, 20))
        && (!('isCustom' in paint) || paint.isCustom is bool);
    }

    function isValidCustomPaintsList(paints) {
      return isValidList(paints, 200)
        && (
          paints.size() == 0
          || (
            isValidCustomPaint(paints[0])
            && isValidCustomPaint(paints[paints.size() - 1])
          )
        );
    }

    // Validate UserPreferences map
    function isValidPreferences(prefs) {
      return prefs is map
        && prefs.size() <= 10
        && (!('defaultRangeFilter' in prefs) || (prefs.defaultRangeFilter is string && prefs.defaultRangeFilter in ['all', 'warhammer_colour', 'warhammer_pro']))
        && (!('allowCompatibleSubstitutions' in prefs) || prefs.allowCompatibleSubstitutions is bool)
        && (!('allowThirdPartySubstitutions' in prefs) || prefs.allowThirdPartySubstitutions is bool)
        && (!('preferredThirdPartyBrands' in prefs) || isValidStringIdList(prefs.preferredThirdPartyBrands, 50));
    }

    // Validate full or partial (`merge: true`) UserAccountState document
    function isValidUserAccountState(data, userId) {
      return hasOnlyAllowedFields(data, [
          'schemaVersion',
          'updatedAt',
          'inventoryPaintIds',
          'wishlistPaintIds',
          'inventoryModelIds',
          'wishlistModelIds',
          'customPaints',
          'customCompatibilityOverrides',
          'modelProgress',
          'projects',
          'uploadedPhotos',
          'preferences'
        ])
        && data.keys().size() >= 1
        && (!('schemaVersion' in data) || (data.schemaVersion is number && data.schemaVersion >= 1 && data.schemaVersion <= 1000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64))
        && (!('inventoryPaintIds' in data) || isValidStringIdList(data.inventoryPaintIds, 1000))
        && (!('wishlistPaintIds' in data) || isValidStringIdList(data.wishlistPaintIds, 500))
        && (!('inventoryModelIds' in data) || isValidStringIdList(data.inventoryModelIds, 2000))
        && (!('wishlistModelIds' in data) || isValidStringIdList(data.wishlistModelIds, 1000))
        && (!('customPaints' in data) || isValidCustomPaintsList(data.customPaints))
        && (!('customCompatibilityOverrides' in data) || (data.customCompatibilityOverrides is map && data.customCompatibilityOverrides.size() <= 500))
        && (!('modelProgress' in data) || (data.modelProgress is map && data.modelProgress.size() <= 500))
        && (!('projects' in data) || isValidProjectsList(data.projects))
        && (!('uploadedPhotos' in data) || isValidUploadedPhotosList(data.uploadedPhotos, userId))
        && (!('preferences' in data) || isValidPreferences(data.preferences));
    }

    // ===============================================================
    // Public Read-Only Catalog Collections & Manifest/Bundles
    // ===============================================================

    match /catalog_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /paints/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /paint_compatibility/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /third_party_paints/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /colours/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /colour_groups/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /games/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /factions/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /recipes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Per-User Cloud Sync Document (`/users/{userId}`)
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && uidUnchanged()
        && isValidUserAccountState(request.resource.data, userId);
      allow update: if isOwner(userId)
        && uidNotModified()
        && isValidUserAccountState(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
